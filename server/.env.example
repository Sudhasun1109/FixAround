# ============================================================
# FixAround Server — Environment Configuration
# ============================================================
PORT=3000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
API_BASE_URL=http://localhost:3000/api/v1

# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=fixaround_db
DB_CONNECTION_LIMIT=10

# Authentication (JWT)
JWT_SECRET=your_super_secret_jwt_key_change_this_min_32_chars
JWT_EXPIRES_IN=24h
REFRESH_TOKEN_SECRET=your_refresh_token_secret_change_this
REFRESH_TOKEN_EXPIRES_IN=7d

# Google OAuth
GOOGLE_CLIENT_ID=

# Maps & Geolocation
MAPS_API_KEY=

# Payment Sandbox & Gateways
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Mail / Notifications
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@fixaround.com

# Platform Defaults
TECHNICIAN_RESPONSE_TIMEOUT_SECONDS=300
TECHNICIAN_MAX_ASSIGNMENT_ATTEMPTS=3
PLATFORM_COMMISSION_PERCENT=15
DEFAULT_SEARCH_RADIUS_KM=10
DEFAULT_WARRANTY_PERIOD_DAYS=7

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=3000
AUTH_RATE_LIMIT_MAX=200

# File Uploads
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=5
