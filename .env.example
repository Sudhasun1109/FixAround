# ============================================================
# FixAround — Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# --- Server ---
PORT=3000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
API_BASE_URL=http://localhost:3000/api/v1

# --- MySQL Database ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=fixaround_db

# --- JWT ---
JWT_SECRET=your_super_secret_jwt_key_change_this
JWT_EXPIRES_IN=24h
REFRESH_TOKEN_SECRET=your_refresh_token_secret_change_this
REFRESH_TOKEN_EXPIRES_IN=7d

# --- Maps / Geolocation (optional) ---
MAPS_API_KEY=

# --- Payment Gateway Sandbox (optional) ---
# Razorpay sandbox
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Stripe sandbox
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Email Provider (optional) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@fixaround.com

# --- SMS Provider (optional) ---
SMS_API_KEY=
SMS_SENDER_ID=

# --- Platform Configuration ---
TECHNICIAN_RESPONSE_TIMEOUT_SECONDS=300
TECHNICIAN_MAX_ASSIGNMENT_ATTEMPTS=3
PLATFORM_COMMISSION_PERCENT=15
DEFAULT_SEARCH_RADIUS_KM=10
DEFAULT_WARRANTY_PERIOD_DAYS=7

# --- Rate Limiting ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=3000
AUTH_RATE_LIMIT_MAX=200

# --- File Uploads (optional) ---
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=5
