# ============================================================
# FixAround — Root Environment Configuration Template
# ============================================================
# Copy this file to server/.env and client/.env respectively.
# NEVER commit .env to version control.
# ============================================================

# --- Server ---
PORT=3000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
API_BASE_URL=http://localhost:3000/api/v1

# --- Database (TiDB Cloud Serverless / MySQL) ---
# For TiDB Cloud: Host is your cluster endpoint, Port is 4000, DB_SSL=true
# For Local MySQL: Host is localhost, Port is 3306, DB_SSL=false
DB_HOST=gateway01.ap-southeast-1.prod.aws.tidbcloud.com
DB_PORT=4000
DB_USER=your_tidb_username
DB_PASSWORD=your_tidb_password
DB_NAME=fixaround_db
DB_CONNECTION_LIMIT=10
DB_SSL=true
# Optional: Path to custom CA certificate (only needed for Dedicated clusters)
DB_SSL_CA=

# --- JWT Authentication ---
JWT_SECRET=your_super_secret_jwt_key_change_this_min_32_chars
JWT_EXPIRES_IN=24h
REFRESH_TOKEN_SECRET=your_refresh_token_secret_change_this
REFRESH_TOKEN_EXPIRES_IN=7d

# --- Google OAuth ---
GOOGLE_CLIENT_ID=

# --- Maps / Geolocation (optional) ---
MAPS_API_KEY=

# --- Payment Gateway Sandbox (optional) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Email Provider (optional) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@fixaround.com

# --- Platform Configuration ---
TECHNICIAN_RESPONSE_TIMEOUT_SECONDS=300
TECHNICIAN_MAX_ASSIGNMENT_ATTEMPTS=3
PLATFORM_COMMISSION_PERCENT=15
DEFAULT_SEARCH_RADIUS_KM=10
DEFAULT_WARRANTY_PERIOD_DAYS=7

# --- Rate Limiting ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=3000
AUTH_RATE_LIMIT_MAX=200

# --- Client Public Variables (for client/.env) ---
# VITE_API_BASE_URL=http://localhost:3000/api/v1
# VITE_MAPS_API_KEY=
# VITE_RAZORPAY_KEY_ID=
# VITE_GOOGLE_CLIENT_ID=
