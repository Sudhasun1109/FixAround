          }
        },
        {
          "name": "Reject Estimate",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/bookings/1/estimates/1/reject",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}" }] },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"reason\": \"Price is too high\"\n}" }
          }
        }
      ]
    },
    {
      "name": "Payments",
      "item": [
        {
          "name": "Initiate Payment",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/bookings/1/payments",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}" }] },
