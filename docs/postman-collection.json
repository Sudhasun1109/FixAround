    {
      "name": "Warranty Claims",
      "item": [
        {
          "name": "Create Claim",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/bookings/1/claims",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}" }] },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"issueDescription\": \"Fan stopped working again after 2 days\",\n  \"evidenceNotes\": \"Same humming noise as before\"\n}" }
