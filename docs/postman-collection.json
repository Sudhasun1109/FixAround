          "request": {
            "method": "PATCH",
            "url": "{{baseUrl}}/claims/1/resolve",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{adminToken}}" }] },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"status\": \"APPROVED\",\n  \"resolutionType\": \"RE_SERVICE\",\n  \"resolutionNotes\": \"Free re-service approved within 48 hours\"\n}" }
          }
        }
      ]
    },
    {
      "name": "Notifications",
