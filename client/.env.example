# ============================================================
# FixAround Client — Environment Configuration
# ============================================================
# Copy this file to client/.env and fill in your values.
# NEVER commit client/.env to version control.
# ============================================================

# Backend API Base URL
VITE_API_BASE_URL=http://localhost:3000/api/v1

# Google Maps / Places API Key (optional for interactive location picker)
VITE_MAPS_API_KEY=

# Razorpay Key ID (Public key for checkout modal, e.g. rzp_test_...)
VITE_RAZORPAY_KEY_ID=

# Google OAuth Client ID (optional for Google login)
VITE_GOOGLE_CLIENT_ID=
